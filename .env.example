# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
# Voices: Kore, Aoede (clear support tone), Charon, Puck, etc.
GEMINI_VOICE=Kore
GEMINI_TEMPERATURE=0.5
GEMINI_MAX_TOKENS=512

# Outbound — short words (yes/no/hindi/english): lower ULTRA/SHORT flush only; long sentences use FLUSH_LONG + VAD unchanged.
# GEMINI_OUTBOUND_TRANSCRIPTION_DEBOUNCE_SEC=0.03
# GEMINI_OUTBOUND_TRANSCRIPTION_FLUSH_ULTRA_SHORT_SEC=0.025
# GEMINI_OUTBOUND_TRANSCRIPTION_FLUSH_SHORT_SEC=0.028
# GEMINI_OUTBOUND_TRANSCRIPTION_FLUSH_LONG_SEC=0.052
# GEMINI_OUTBOUND_VAD_SILENCE_DURATION_MS=145

# After spoken "please wait" before tools run — was ~0.9s (long dead air). Lower = snappier.
# TOOL_HOLD_PAUSE_SEC=0.28

# Outbound: false = compact prompt (faster). true = full HTML script (~25k chars, slower).
OUTBOUND_FULL_PROTOCOL=false

# Telephony: mock | twilio | exotel
# mock = build session only, no real call (testing)
TELEPHONY_PROVIDER=mock

# Twilio (outbound + inbound). Indian numbers limited on Twilio.
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Exotel (recommended for India outbound/inbound)
# When you use a NEW Exotel account/sub-account, update ALL of these in .env — old values will 403 or dial the wrong flow.
#
# Credentials: Dashboard → Settings → API (or Developer) → API Key + Token + Account SID (subdomain, e.g. mycompany from mycompany.exotel.in).
# EXOTEL_ACCOUNT_SID=mycompany
# EXOTEL_API_KEY=...
# EXOTEL_API_TOKEN=...
# Caller ID must be an Exophone on THIS account:
# EXOTEL_CALLER_ID=0XXXXXXXXXX
#
# Regional API host — MUST match **Exotel account region** (dashboard), not where you live:
#   Singapore cluster account:     EXOTEL_API_HOST=https://api.exotel.com   ← use this if dashboard says "Singapore"
#   India / Mumbai cluster account: EXOTEL_API_HOST=https://api.in.exotel.com
# (You can operate from India with a Singapore-region account; wrong host → auth/API errors.)
#
# App Bazaar: recreate or copy Voice flows on the new account; IDs differ from the old account.
# EXOTEL_OUTBOUND_APP_ID=new_outbound_voice_flow_id
# Optional full ExoML start URL if you prefer explicit over auto-built:
# EXOTEL_OUTBOUND_FLOW_URL=http://my.exotel.com/mycompany/exoml/start_voice/NEW_OUTBOUND_APP_ID
#
# Inbound support (defaults to outbound app ID if unset — set if inbound uses a different flow):
# EXOTEL_INBOUND_APP_ID=new_inbound_voice_flow_id
# EXOTEL_INBOUND_FLOW_URL=http://my.exotel.com/mycompany/exoml/start_voice/NEW_INBOUND_APP_ID
#
# In EVERY Voicebot applet on the NEW account: set dynamic HTTPS URL to your PUBLIC tunnel (restart ngrok = update PUBLIC_*).
# Outbound applet: https://YOUR_NGROK/voice/outbound/exotel-answer
# Inbound applet: https://YOUR_NGROK/voice/inbound/exotel-answer (or same as outbound — see docs/EXOTEL_OUTBOUND_SETUP.md)
#
# Verify after changes: GET http://127.0.0.1:7860/voice/exotel-setup (while server is up)

# Public URLs (ngrok: ngrok http 7860)
# WebSocket for media stream:
#   wss://abc123.ngrok-free.app
PUBLIC_WS_URL=
# HTTPS for outbound answer webhooks (optional; derived from PUBLIC_WS_URL if empty)
# PUBLIC_HTTP_URL=https://abc123.ngrok-free.app

# Server
HOST=0.0.0.0
PORT=7860
LOG_LEVEL=INFO
DEBUG=false

# Order data: mock | shopify | api
DATA_SOURCE=mock

# Order desk — agent reads/writes customer & shipping here (PHP UI imports Shopify export)
ORDER_DESK_ENABLED=true
ORDER_DESK_JSON_PATH=data/order_desk.json
# Optional — secures POST /api/order-desk/* (PHP post-save hook, scripts). Header: X-Order-Desk-Sync-Secret
ORDER_DESK_SYNC_SECRET=choose-a-long-random-string
# PHP order desk reads this from repo .env automatically (bootstrap.php); push URL defaults to:
# http://127.0.0.1:7860/api/order-desk/push-save-to-shopify

# --- Shopify (set DATA_SOURCE=shopify) ---
# Custom app Admin API scopes (minimum):
#   read_orders   — order status, refunds list, fulfillments/tracking
#   write_orders  — cancel_order tool
#   read_customers — optional; name/phone usually come with the order
# SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com  (Settings → Domains, NOT your .com domain)
# SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxx
# SHOPIFY_API_VERSION=2024-10
# SHOPIFY_WEBHOOK_SECRET=from_shopify_webhook_settings
# AUTO_CONFIRMATION_ENABLED=true
# Optional — only webhook-dial orders that have this tag (Shopify Tags and/or order desk JSON):
# CONFIRMATION_WEBHOOK_REQUIRE_TAG=Call AI Confirm

# --- Generic REST API (non-Shopify) ---
# Example: https://api.yourshop.com/v1
STORE_API_BASE_URL=
STORE_API_KEY=
# Optional: use X-API-Key instead of Authorization Bearer
# STORE_API_HEADER_NAME=X-API-Key
STORE_API_TIMEOUT=30
# Override paths if your API differs ({order_id} is required)
# STORE_API_PATH_ORDER=/orders/{order_id}
# STORE_API_PATH_REFUND=/orders/{order_id}/refund
# STORE_API_PATH_CANCEL=/orders/{order_id}/cancel
# STORE_API_PATH_TRACK=/orders/{order_id}/tracking
