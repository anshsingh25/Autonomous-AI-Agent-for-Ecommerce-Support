# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
# Voices: Kore, Aoede (clear support tone), Charon, Puck, etc.
GEMINI_VOICE=Kore
GEMINI_TEMPERATURE=0.5
GEMINI_MAX_TOKENS=512

# Outbound: false = compact prompt (faster). true = full HTML script (~25k chars, slower).
OUTBOUND_FULL_PROTOCOL=false

# Telephony: mock | twilio | exotel
# mock = build session only, no real call (testing)
TELEPHONY_PROVIDER=mock

# Twilio (outbound + inbound). Indian numbers limited on Twilio.
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Exotel (recommended for India outbound/inbound)
# EXOTEL_ACCOUNT_SID=your_account_sid
# EXOTEL_API_KEY=your_api_key
# EXOTEL_API_TOKEN=your_api_token
# EXOTEL_CALLER_ID=your_exophone_number
# EXOTEL_API_HOST=https://api.exotel.com  (or https://api.in.exotel.com for India-only accounts)
# Outbound confirmation (required or call drops when customer answers):
# EXOTEL_OUTBOUND_APP_ID=your_app_bazaar_flow_id
# Voicebot dynamic URL in that flow: https://YOUR_NGROK/voice/outbound/exotel-answer
# EXOTEL_OUTBOUND_FLOW_URL=http://my.exotel.com/your_account/exoml/start_voice/YOUR_APP_ID

# Public URLs (ngrok: ngrok http 7860)
# WebSocket for media stream:
#   wss://abc123.ngrok-free.app
PUBLIC_WS_URL=
# HTTPS for outbound answer webhooks (optional; derived from PUBLIC_WS_URL if empty)
# PUBLIC_HTTP_URL=https://abc123.ngrok-free.app

# Server
HOST=0.0.0.0
PORT=7860
LOG_LEVEL=INFO
DEBUG=false

# Order data: mock | shopify | api
DATA_SOURCE=mock

# --- Shopify (set DATA_SOURCE=shopify) ---
# Custom app Admin API scopes (minimum):
#   read_orders   — order status, refunds list, fulfillments/tracking
#   write_orders  — cancel_order tool
#   read_customers — optional; name/phone usually come with the order
# SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com  (Settings → Domains, NOT your .com domain)
# SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxx
# SHOPIFY_API_VERSION=2024-10
# SHOPIFY_WEBHOOK_SECRET=from_shopify_webhook_settings
# Auto-dial customers when unfulfilled orders are created/paid
AUTO_CONFIRMATION_ENABLED=true

# --- Generic REST API (non-Shopify) ---
# Example: https://api.yourshop.com/v1
STORE_API_BASE_URL=
STORE_API_KEY=
# Optional: use X-API-Key instead of Authorization Bearer
# STORE_API_HEADER_NAME=X-API-Key
STORE_API_TIMEOUT=30
# Override paths if your API differs ({order_id} is required)
# STORE_API_PATH_ORDER=/orders/{order_id}
# STORE_API_PATH_REFUND=/orders/{order_id}/refund
# STORE_API_PATH_CANCEL=/orders/{order_id}/cancel
# STORE_API_PATH_TRACK=/orders/{order_id}/tracking
